{
  "name": "@armonia-framework/cli",
  "version": "1.0.0-rc.1",
  "description": "Language-independent repository governance and developer-experience framework.",
  "type": "module",
  "bin": {
    "armonia": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "spec",
    "packs",
    "policies",
    "ai",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node --experimental-strip-types src/cli.ts version",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/core.test.ts test/cli.test.ts test/security.test.ts test/yaml.test.ts",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test && node --experimental-strip-types src/cli.ts validate .",
    "armonia": "node --experimental-strip-types src/cli.ts",
    "prepack": "pnpm run verify"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "keywords": [
    "repository",
    "governance",
    "developer-experience",
    "github-actions",
    "coding-agents",
    "ai"
  ]
}
