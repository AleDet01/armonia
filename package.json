{
  "name": "armonia-repo",
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "description": "Evidence-based consistency checks for repositories and software ecosystems.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleDet01/Armonia.git"
  },
  "bugs": {
    "url": "https://github.com/AleDet01/Armonia/issues"
  },
  "homepage": "https://AleDet01.github.io/Armonia/",
  "keywords": [
    "repository",
    "consistency",
    "documentation",
    "devops",
    "cli",
    "sarif"
  ],
  "bin": {
    "armonia": "./bin/armonia.mjs"
  },
  "files": [
    "bin",
    "src/core",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prepare-static.mjs",
    "start": "vinext start",
    "scan": "node bin/armonia.mjs scan .",
    "scan:json": "node bin/armonia.mjs scan . --format json --output .armonia/report.json",
    "portfolio:example": "node bin/armonia.mjs portfolio --registry examples/portfolio/registry.json --output .armonia/portfolio-snapshot.json",
    "test": "node --experimental-strip-types --test tests/engine.test.mjs tests/browser-scan.test.mjs tests/cli.test.mjs tests/config.test.mjs",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node --test tests/rendered-html.test.mjs && npm run scan",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.6.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0",
    "vite": "^8.3.2"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "type": "module"
}
