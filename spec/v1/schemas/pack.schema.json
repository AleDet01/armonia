{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armonia.invalid/spec/v1/pack.schema.json",
  "title": "Armonìa Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "compatibility"],
  "properties": {
    "apiVersion": { "const": "armonia/v1" },
    "kind": { "const": "Pack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec"],
      "properties": {
        "spec": { "type": "string", "minLength": 1 }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "cwd": { "type": "string" },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "source", "ownership"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "ownership": {
            "enum": ["managed", "scaffold", "reference"]
          },
          "condition": { "type": "string" }
        }
      }
    },
    "policies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
