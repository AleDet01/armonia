{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armonia.dev/spec/v1/profile.schema.json",
  "title": "Armonìa policy profile",
  "description": "An enforcement profile selects atomic policy rules and may raise or lower their severity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "rules"],
  "properties": {
    "apiVersion": { "const": "armonia/v1" },
    "kind": { "const": "PolicyProfile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 10 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "severity": { "enum": ["info", "warning", "error"] }
        }
      }
    }
  }
}
