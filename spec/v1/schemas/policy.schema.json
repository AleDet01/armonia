{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armonia.invalid/spec/v1/policy.schema.json",
  "title": "Armonìa Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "title",
    "description",
    "defaultSeverity",
    "check",
    "remediation"
  ],
  "properties": {
    "apiVersion": { "const": "armonia/v1" },
    "kind": { "const": "Policy" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "defaultSeverity": {
      "enum": ["info", "warning", "error"]
    },
    "check": { "type": "string", "minLength": 1 },
    "path": { "type": "string" },
    "remediation": { "type": "string", "minLength": 1 }
  }
}
